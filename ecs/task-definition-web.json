{
  "family": "pet-app-angular21-task",
  "networkMode": "awsvpc",
  "requiresCompatibilities": ["FARGATE"],
  "cpu": "512",
  "memory": "1024",
  "executionRoleArn": "arn:aws:iam::622519216316:role/LabRole",
  "containerDefinitions": [
    {
      "name": "pet-app-angular21",
      "image": "622519216316.dkr.ecr.us-east-1.amazonaws.com/pet-app-angular21:b1432c8dc6faa00a902f364afb3cfaf04afbedd1",
      "essential": true,
      "portMappings": [
        {
          "containerPort": 4000,
          "hostPort": 4000,
          "protocol": "tcp"
        }
      ],
      "environment": [
        { "name": "PORT", "value": "4000" }
      ],
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/pet-app-angular21",
          "awslogs-region": "us-east-1",
          "awslogs-stream-prefix": "ecs"
        }
      }
    }
  ]
}
